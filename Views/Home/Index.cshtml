@model AuroraGaleria.Models.HomeViewModel
@{
    ViewData["Title"] = "Galeria Aurora";
}

<section class="hero">
    <div class="hero-content">
        <h1>GALERIA AURORA</h1>
        <p>Arte contemporânea e experiências imersivas.</p>
        <a href="#exposicoes" class="btn-main">Explorar</a>
    </div>
</section>

<section id="exposicoes" class="section">
    <h2>Exposições — Arte Contemporânea</h2>
    <div class="cards">
        @foreach (var expo in Model.Exposicoes)
        {
            <article class="card">
                <img src="@expo.ImagemUrl" alt="Obra representativa da exposição @expo.Titulo">
                <div class="card-content">
                    <h3>@expo.Titulo</h3>
                    <p>@expo.Descricao</p>
                    <span>@expo.Periodo</span>
                </div>
            </article>
        }
    </div>
</section>

<section id="comprar-ingressos" class="tickets">
    <div class="ticket-box">
        <h2>Reservar ingressos</h2>
        <p class="academic-notice">Projeto acadêmico: esta reserva é uma simulação e não realiza cobrança.</p>
        <form id="ticketForm">
            <label for="ticketSession">Sessão</label>
            <select id="ticketSession" required @(Model.Sessoes.Count == 0 ? "disabled" : null)>
                <option value="">Selecione exposição, data e horário</option>
                @foreach (var session in Model.Sessoes.Where(item => item.Available > 0))
                {
                    <option value="@session.Id">@session.ExposureName — @session.Date às @session.Time (@session.Available vagas)</option>
                }
            </select>
            <label for="ticketQuantity">Quantidade</label>
            <input id="ticketQuantity" type="number" min="1" max="20" value="1" required>
            <button type="submit" @(Model.Sessoes.Count == 0 ? "disabled" : null)>Reservar</button>
            @if (Model.Sessoes.Count == 0) { <p>Não há sessões futuras disponíveis no momento.</p> }
        </form>
    </div>
</section>

<section id="agendar-visita" class="agenda">
    <div class="agenda-box">
        <h2>Agendar visita</h2>
        <form id="agendaForm">
            <label for="agendaSession">Sessão</label>
            <select id="agendaSession" required @(Model.Sessoes.Count == 0 ? "disabled" : null)>
                <option value="">Selecione exposição, data e horário</option>
                @foreach (var session in Model.Sessoes.Where(item => item.Available > 0))
                {
                    <option value="@session.Id">@session.ExposureName — @session.Date às @session.Time (@session.Available vagas)</option>
                }
            </select>
            <button type="submit" @(Model.Sessoes.Count == 0 ? "disabled" : null)>Agendar</button>
        </form>
    </div>
</section>

<section id="lojinha" class="shop">
    <h2>Lojinha</h2>
    <p class="academic-notice">Compra simulada para fins acadêmicos. Não informe dados reais de pagamento.</p>
    <div class="shop-grid">
        @foreach (var product in Model.Produtos)
        {
            <article class="product" data-product-id="@product.Id">
                <div class="product-image-frame">
                    <img src="@product.ImagemUrl" alt="@product.Nome">
                </div>
                <h3>@product.Nome</h3>
                <p>@product.Preco.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</p>
                <button type="button">Adicionar ao carrinho</button>
            </article>
        }
    </div>
</section>
<footer><p>Galeria Aurora © 2026 — Arte contemporânea para todos.</p></footer>
